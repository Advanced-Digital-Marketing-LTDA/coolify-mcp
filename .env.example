# Trusted process configuration; callers cannot override the origin or path.
# Validate a filled-in environment with `npm run preflight` (see docs/owner-setup.md).
# This reserved example value is rejected by the activation gate.
COOLIFY_ORIGIN=https://coolify.example.invalid

# Set to the final trusted HTTPS MCP origin before activation. No HTTP origin is accepted.
MCP_PUBLIC_ORIGIN=

# Explicit ingress IPs/CIDRs, comma separated; required for OAuth per-client quotas.
# Use actual proxy addresses; wildcard ranges and numeric hop counts are rejected.
MCP_TRUSTED_PROXY_CIDRS=

# Generic OIDC confidential client. Keep the client secret in the deployment secret manager.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The owner-approved pinned server.
COOLIFY_TARGET_SERVER_NAME="AI Agents"

# The approved UUID is provided; configure the owner identity before activation.
# All projects/resources are still checked against this one server UUID.
COOLIFY_TARGET_SERVER_UUID=pcrionkfci16zmkssngc6vaa
# Stable, non-email OIDC subject of the one authorized owner. No first-login enrollment.
COOLIFY_OWNER_SUBJECT=

# Enter separately through the approved secret manager after publication approval.
# Never put a live token in this file or repository.
COOLIFY_API_TOKEN=
